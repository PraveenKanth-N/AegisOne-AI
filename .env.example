# AegisOne AI - Environment Configuration Example
# Copy this file to .env for local runtime configuration

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Default is local SQLite with async driver; PostgreSQL supported when available
DATABASE_URL=sqlite+aiosqlite:///./aegisone.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aegisone

# Security Knowledge Graph Configuration
# If USE_NEO4J is false, AegisOne automatically uses the built-in NetworkX graph engine
USE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aegisone_secret

# AI Provider Configuration
# AI_PROVIDER can be 'mock' (deterministic, zero hallucination), 'openai', or 'gemini'
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-4o-mini

# Authentication & Security Guardrails
JWT_SECRET_KEY=aegisone_super_secret_key_change_in_production_32bytes!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Scope Guard Enforcement (Non-negotiable defensive boundary)
# Scans against non-whitelisted targets are strictly blocked by the platform
ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,host.docker.internal,college-placement-portal

# Security Scanners Configuration
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=
SEMGREP_RULES_PATH=./security-engine/rules

# Vulnerable Lab Target
VULNERABLE_APP_URL=http://localhost:8001
